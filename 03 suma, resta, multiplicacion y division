Algoritmo PRACTICA_3
	//REALIZE UN PROGRAMA QUE PERMITA UZAR DOS NUMEROS 
	//PARA REALIZAR LA 4 OPERACIONES AL MISMO TIEMPO
	//DEFINIR VARIABLE
	definir numero1, numero2 Como Entero
	definir suma, resta, multiplicacion Como Entero
	definir division Como Real
